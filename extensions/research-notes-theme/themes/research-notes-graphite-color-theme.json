    },
    {
      "name": "Math",
      "scope": [
        "support.function.math",
        "constant.other.math",
        "meta.math.block",
        "meta.math.inline"
      ],
      "settings": {
        "foreground": "#adbccd",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a8be9b",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e99a93",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#d6bb8c",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e99a93",
        "fontStyle": "underline"
      }
