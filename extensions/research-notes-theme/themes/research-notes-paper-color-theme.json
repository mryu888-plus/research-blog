  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#666670",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5e5e68",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#5e5e68",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#242427",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#242427",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#4c6248",
        "fontStyle": ""
      }
    },
    {
      "name": "String punctuation",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4c6248",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.character-class",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
      }
    },
    {
      "name": "Embedded code",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#242427",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#78572f",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#65513a",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#456078",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#456078",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and attributes",
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#745c80",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#5e5e68",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9d4941",
        "fontStyle": ""
