      ],
      "settings": {
        "foreground": "#4c6248",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json meta.structure.dictionary.key"
      ],
      "settings": {
        "foreground": "#242427",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#9d4941",
