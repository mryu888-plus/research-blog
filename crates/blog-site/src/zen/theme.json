    "tab.activeBorderTop": "@accent",
    "tab.activeBorder": "@bg",
    "tab.border": "@border",
    "tab.inactiveBackground": "@panel",
    "tab.inactiveForeground": "@muted",
    "tab.unfocusedActiveForeground": "@secondary",
