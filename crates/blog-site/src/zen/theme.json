    "editorOverviewRuler.warningForeground": "@warning",
    "editorOverviewRuler.infoForeground": "@info",
    "editorOverviewRuler.addedForeground": "@success/aa",
    "editorOverviewRuler.deletedForeground": "@error/aa",
    "editorOverviewRuler.modifiedForeground": "@info/aa",
    "editorWidget.background": "@panel",
    "editorWidget.foreground": "@fg",
    "editorWidget.border": "@edge",
    "editorSuggestWidget.background": "@panel",
    "editorSuggestWidget.border": "@edge",
    "editorSuggestWidget.foreground": "@fg",
    "editorSuggestWidget.highlightForeground": "@accent",
    "editorSuggestWidget.selectedBackground": "@selection",
    "editorSuggestWidget.selectedForeground": "@fg",
    "editorSuggestWidget.focusHighlightForeground": "@accent",
    "editorHoverWidget.background": "@panel",
    "editorHoverWidget.foreground": "@fg",
    "editorHoverWidget.border": "@edge",
    "editorHoverWidget.statusBarBackground": "@raised",
    "editorInlayHint.background": "@panel",
    "editorInlayHint.foreground": "@muted",
    "peekView.border": "@edge",
    "peekViewTitle.background": "@panel",
    "peekViewTitleLabel.foreground": "@fg",
    "peekViewTitleDescription.foreground": "@secondary",
    "peekViewEditor.background": "@bg",
    "peekViewResult.background": "@panel",
    "peekViewResult.fileForeground": "@fg",
    "peekViewResult.lineForeground": "@secondary",
    "peekViewResult.selectionBackground": "@selection",
    "peekViewResult.selectionForeground": "@fg",
    "peekViewEditor.matchHighlightBackground": "@accent/25",
    "peekViewResult.matchHighlightBackground": "@accent/25",
    "diffEditor.insertedTextBackground": "@success/24",
    "diffEditor.removedTextBackground": "@error/24",
    "diffEditor.insertedLineBackground": "@success/0d",
    "diffEditor.removedLineBackground": "@error/0d",
    "diffEditor.diagonalFill": "@border",
    "diffEditor.border": "@border",
    "merge.currentHeaderBackground": "@success/35",
    "merge.currentContentBackground": "@success/12",
    "merge.incomingHeaderBackground": "@info/35",
    "merge.incomingContentBackground": "@info/12",
    "merge.commonHeaderBackground": "@muted/30",
    "merge.commonContentBackground": "@muted/10",
    "panel.background": "@bg",
    "panel.border": "@border",
    "panelTitle.activeForeground": "@fg",
    "panelTitle.inactiveForeground": "@muted",
    "panelTitle.activeBorder": "@accent",
    "statusBar.background": "@panel",
    "statusBar.foreground": "@secondary",
    "statusBar.border": "@border",
    "statusBar.noFolderBackground": "@panel",
    "statusBar.noFolderForeground": "@secondary",
    "statusBar.debuggingBackground": "@accent",
    "statusBar.debuggingForeground": "@buttonFg",
    "statusBarItem.hoverBackground": "@selection",
    "statusBarItem.remoteBackground": "@selection",
    "statusBarItem.remoteForeground": "@fg",
    "statusBarItem.prominentBackground": "@selection",
    "statusBarItem.prominentForeground": "@fg",
    "statusBarItem.errorBackground": "@error",
    "statusBarItem.errorForeground": "@buttonFg",
    "statusBarItem.warningBackground": "@warning",
    "statusBarItem.warningForeground": "@buttonFg",
    "terminal.background": "@bg",
    "terminal.foreground": "@fg",
    "terminalCursor.foreground": "@accent",
    "terminalCursor.background": "@bg",
    "terminal.selectionBackground": "@selection",
    "terminal.inactiveSelectionBackground": "@inactiveSelection",
    "terminal.ansiBlack": "@ansiBlack",
    "terminal.ansiRed": "@error",
    "terminal.ansiGreen": "@success",
    "terminal.ansiYellow": "@warning",
    "terminal.ansiBlue": "@info",
    "terminal.ansiMagenta": "@purple",
    "terminal.ansiCyan": "@ansiCyan",
    "terminal.ansiWhite": "@ansiWhite",
    "terminal.ansiBrightBlack": "@muted",
    "terminal.ansiBrightRed": "@error",
    "terminal.ansiBrightGreen": "@success",
    "terminal.ansiBrightYellow": "@warning",
    "terminal.ansiBrightBlue": "@info",
    "terminal.ansiBrightMagenta": "@purple",
    "terminal.ansiBrightCyan": "@ansiBrightCyan",
    "terminal.ansiBrightWhite": "@fg",
    "gitDecoration.addedResourceForeground": "@success",
    "gitDecoration.modifiedResourceForeground": "@info",
    "gitDecoration.deletedResourceForeground": "@error",
    "gitDecoration.untrackedResourceForeground": "@success",
    "gitDecoration.ignoredResourceForeground": "@muted",
    "gitDecoration.conflictingResourceForeground": "@warning",
    "gitDecoration.submoduleResourceForeground": "@purple",
    "notificationCenterHeader.background": "@bg",
    "notificationCenterHeader.foreground": "@secondary",
    "notifications.background": "@panel",
    "notifications.foreground": "@fg",
    "notifications.border": "@edge",
    "notificationsErrorIcon.foreground": "@error",
    "notificationsWarningIcon.foreground": "@warning",
    "notificationsInfoIcon.foreground": "@info",
    "breadcrumb.background": "@bg",
    "breadcrumb.foreground": "@muted",
    "breadcrumb.focusForeground": "@fg",
    "breadcrumb.activeSelectionForeground": "@accent",
    "breadcrumbPicker.background": "@panel",
    "menu.background": "@panel",
    "menu.foreground": "@fg",
    "menu.border": "@edge",
    "menu.selectionBackground": "@selection",
    "menu.selectionForeground": "@fg",
    "menu.separatorBackground": "@border",
    "minimap.background": "@bg",
    "minimap.selectionHighlight": "@accent/60",
    "minimap.findMatchHighlight": "@accent",
    "minimap.errorHighlight": "@error",
    "minimap.warningHighlight": "@warning",
    "minimapGutter.addedBackground": "@success",
    "minimapGutter.modifiedBackground": "@info",
    "minimapGutter.deletedBackground": "@error",
    "debugToolBar.background": "@panel",
    "debugToolBar.border": "@edge",
    "debugIcon.breakpointForeground": "@error",
    "debugIcon.startForeground": "@success",
    "debugConsole.infoForeground": "@info",
    "debugConsole.warningForeground": "@warning",
    "debugConsole.errorForeground": "@error",
    "debugConsole.sourceForeground": "@secondary",
    "debugConsoleInputIcon.foreground": "@accent",
    "settings.headerForeground": "@fg",
    "settings.modifiedItemIndicator": "@accent",
    "welcomePage.background": "@bg",
    "welcomePage.tileBackground": "@panel",
    "welcomePage.tileHoverBackground": "@raised",
    "welcomePage.tileBorder": "@border",
    "notebook.editorBackground": "@bg",
    "notebook.cellBorderColor": "@border",
    "notebook.focusedCellBorder": "@accent",
    "notebook.cellEditorBackground": "@bg",
    "notebook.selectedCellBackground": "@line",
    "notebook.outputContainerBackgroundColor": "@panel",
    "charts.foreground": "@secondary",
    "charts.red": "@error",
    "charts.blue": "@info",
    "charts.green": "@success",
    "charts.yellow": "@warning",
    "charts.orange": "@accent",
    "charts.purple": "@purple"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "@muted",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "@secondary",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "@secondary",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "@string",
        "fontStyle": ""
      }
    },
    {
      "name": "String punctuation",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "@string",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.character-class",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Template interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Embedded code",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "@number",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "@function",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "@typeColor",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "@typeColor",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and attributes",
      "scope": [
        "meta.annotation",
        "entity.name.function.decorator",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "@purple",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "@secondary",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "@string",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json meta.structure.dictionary.key"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "@fg",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "@muted",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.inline",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "@string",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "@typeColor",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup link labels",
      "scope": [
        "string.other.link.title",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "@function",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "@muted",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup lists",
      "scope": [
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "@accent",
        "fontStyle": ""
      }
    },
    {
      "name": "Math",
      "scope": [
        "support.function.math",
        "constant.other.math",
        "meta.math.block",
        "meta.math.inline"
      ],
      "settings": {
        "foreground": "@typeColor",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "@success",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "@error",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "@warning",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid tokens",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "@error",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated tokens",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "@muted",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "@typeColor",
    "type": "@typeColor",
    "class": "@typeColor",
    "enum": "@typeColor",
    "interface": "@typeColor",
    "struct": "@typeColor",
    "typeParameter": "@typeColor",
    "parameter": "@fg",
    "variable": "@fg",
    "property": "@secondary",
    "enumMember": "@number",
    "variable.readonly": "@number",
    "property.readonly": "@number",
    "function": "@function",
    "method": "@function",
    "macro": "@function",
    "decorator": "@purple",
    "event": "@function",
    "keyword": "@accent",
    "modifier": "@accent",
    "comment": {
      "foreground": "@muted",
      "italic": true
    },
    "string": "@string",
    "number": "@number",
    "regexp": "@string",
    "operator": "@secondary",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
