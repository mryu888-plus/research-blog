    "editorBracketHighlight.foreground4": "@function",
    "editorBracketHighlight.foreground5": "@string",
    "editorBracketHighlight.foreground6": "@purple",
    "editorBracketHighlight.unexpectedBracket.foreground": "@error",
    "editorError.foreground": "@error",
    "editorWarning.foreground": "@warning",
    "editorInfo.foreground": "@info",
    "editorHint.foreground": "@muted",
    "editorGutter.background": "@bg",
